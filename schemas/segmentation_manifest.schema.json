{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/paper-segmentation-manifest-1.0.schema.json",
  "title": "Paper segmentation manifest row",
  "type": "object",
  "required": [
    "schema_version", "capture_id", "source_path", "source_sha256",
    "original_size_hw", "bbox_xywh", "mask_path", "piece_path",
    "piece_mask_path", "overlay_path", "model_version", "accepted",
    "review_status", "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "paper-segmentation-manifest-1.0"},
    "capture_id": {"type": "string", "description": "Unique individual piece observation ID; multiple rows can share one source image."},
    "source_capture_id": {"type": "string", "description": "Input photo/page identity, shared by its individual proposals."},
    "candidate_id": {"type": "string"},
    "artifact_id": {"type": "string", "description": "Unique artifact filename key. Never key multi-piece artifacts by source_sha256 alone."},
    "empty_proposal": {"type": "boolean", "description": "Pending source-review placeholder when inference found zero pieces; never an accepted physical piece."},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "original_size_hw": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "integer", "minimum": 1}
    },
    "bbox_xywh": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "integer", "minimum": 0}
    },
    "accepted": {"type": "boolean"},
    "review_status": {
      "enum": ["auto_accepted", "needs_review", "manually_reviewed"]
    },
    "reason_codes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
